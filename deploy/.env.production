# =============================================================================
# GenFlow v2 — Production Environment Variables
# Copy to .env and adjust values for your server
# =============================================================================

# Server
API_PORT=3000
WEB_PORT=3001

# Database
DB_USER=genflow
DB_PASS=genflow
DB_NAME=genflow
DB_PORT=5432

# Redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Resource Limits (Docker)
API_CPU_LIMIT=2
API_MEM_LIMIT=1G
API_CPU_RES=0.5
API_MEM_RES=256M
WEB_CPU_LIMIT=1
WEB_MEM_LIMIT=512M
WEB_CPU_RES=0.25
WEB_MEM_RES=128M
DB_CPU_LIMIT=2
DB_MEM_LIMIT=2G
DB_CPU_RES=0.5
DB_MEM_RES=512M
REDIS_CPU_LIMIT=1
REDIS_MEM_LIMIT=512M
REDIS_CPU_RES=0.1
REDIS_MEM_RES=64M

# AI Providers (optional — for MCP enhancement)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# HTTP/HTTPS
HTTP_PORT=80
HTTPS_PORT=443
